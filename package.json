{
  "packageManager": "bun@1.4.0",
  "name": "@forgeax/extension-platform",
  "version": "0.7.0",
  "description": "ForgeaX extension platform workspace",
  "private": false,
  "workspaces": [
    "packages/*"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ForgeaX-Games/forgeax-extension-platform.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/base/index.d.ts",
      "import": "./dist/base/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./permissions": {
      "types": "./dist/permissions/policy.d.ts",
      "import": "./dist/permissions/policy.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics/error.d.ts",
      "import": "./dist/diagnostics/error.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && for package in @forgeax/design @forgeax/platform-io @forgeax/extension-artifacts @forgeax/extension-sdk; do bun run --filter \"$package\" build || exit 1; done",
    "test": "bun run --filter '*' test && bun test test/*.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsup --config tsup.config.ts && bun run --filter @forgeax/extension-artifacts build && bun run --filter '*' typecheck",
    "check": "bun run typecheck && bun run test && bun run build",
    "verify:workspace": "bun scripts/verify-workspace.ts",
    "release:preflight": "bun scripts/release-preflight.ts",
    "release:capture": "bun scripts/release-capture.ts",
    "release:verify": "bun scripts/release-verify.ts",
    "ci": "bun install --frozen-lockfile && bun run typecheck && bun run test && bun run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@forgeax/toolkit": "0.1.2",
    "@forgeax/types": "^0.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
