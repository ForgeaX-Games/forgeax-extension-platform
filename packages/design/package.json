{
  "name": "@forgeax/design",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ForgeaX-Games/forgeax-extension-platform.git",
    "directory": "packages/design"
  },
  "publishConfig": { "access": "public" },
  "description": "Reusable ForgeaX visual tokens and primitive contracts",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./styles/primitive.css": "./dist/styles/primitive.css",
    "./styles/semantic.css": "./dist/styles/semantic.css",
    "./styles/fx-bridge.css": "./dist/styles/fx-bridge.css",
    "./styles/reset.css": "./dist/styles/reset.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --strict --skipLibCheck --verbatimModuleSyntax src/*.ts",
    "test": "bun test test/*.test.ts",
    "build": "tsup src/index.ts --format esm --dts --outDir dist && node scripts/copy-styles.mjs"
  },
  "private": false
}
